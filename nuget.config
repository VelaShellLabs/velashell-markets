<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- 本地源:VelaShell 仓库打出的 SDK 包(容器构建时由 build/ 下的脚本预先灌进来)。
         SDK 发到 nuget.org 之后这一条可以删掉。 -->
    <add key="velashell-local" value="./packages" />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
