{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "OpenIddict": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Mongo": "mongodb://localhost:27017/velashell-identity"
  },
  "Identity": {
    "Issuer": "http://localhost:7020",
    "RequireHttps": false,
    "KeyDirectory": "keys",
    "AccessTokenLifetime": "01:00:00",
    "IdentityTokenLifetime": "00:20:00",
    "RefreshTokenLifetime": "14.00:00:00",
    "Scopes": [
      {
        "Name": "velashell-market",
        "DisplayName": "VelaShell 插件市场",
        "Resources": [ "velashell-market" ]
      }
    ],
    "Clients": [
      {
        "ClientId": "velashell-market-web",
        "DisplayName": "VelaShell 插件市场",
        "RedirectUris": [ "http://localhost:8000/callback" ],
        "PostLogoutRedirectUris": [ "http://localhost:8000" ],
        "Scopes": [ "velashell-market" ]
      }
    ]
  },
  "Accounts": {
    "AllowSelfRegistration": true,
    "MinimumPasswordLength": 8,
    "MaxFailedAttempts": 8,
    "LockoutDuration": "00:15:00"
  }
}
