<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>VelaShell.Market.Identity</RootNamespace>
    <UserSecretsId>velashell-market-identity</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenIddict:OIDC 服务端(授权码 + PKCE)与 MongoDB 存储。
         口令散列用的 PasswordHasher<T> 在 ASP.NET Core 共享框架里
         (Microsoft.Extensions.Identity.Core),不需要额外的包。 -->
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="OpenIddict.MongoDb" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

</Project>
