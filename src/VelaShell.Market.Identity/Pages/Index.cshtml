@page "/"
@model IndexModel
@{
    ViewData["Title"] = Model.Account is null ? "统一认证" : "账户";
    // 没登录时沿用登录页那套左右分栏(要说清楚"这是谁");
    // 登录之后这一页只是看信息 + 改口令,换成普通页面。
    ViewData["Shell"] = Model.Account is null ? "split" : "page";

    string displayName = Model.Account?.DisplayName ?? Model.Account?.UserName ?? "";
    string initials = displayName.Length > 0 ? displayName[..1].ToUpperInvariant() : "?";
}

@*
    两个 section 都在顶层声明(Razor 不允许把 section 写进 if 里),内容各自按登录状态取舍。
    布局那边会把当前外壳用不到的那个 IgnoreSection 掉 —— 声明了却没人渲染会直接抛异常。
*@
@section Aside {
    @if (Model.Account is null)
    {
        <div class="aside-pitch">
            <h2>VelaShell 统一认证</h2>
            <p>插件市场的上传、评价与审核都用这里的账号。浏览和搜索不需要登录。</p>
            <ul class="aside-points">
                <li>
                    <span class="mark">@await Html.PartialAsync("_Icon", "shield-check")</span>
                    <span>
                        <b>只签发有期限的访问令牌</b>
                        <span>插件市场拿不到你的口令,也读不到这里的会话 cookie。</span>
                    </span>
                </li>
                <li>
                    <span class="mark">@await Html.PartialAsync("_Icon", "fingerprint")</span>
                    <span>
                        <b>登录后能看到自己的 sub</b>
                        <span>部署方把它填进审核员名单,这个账号才进得了审核台。</span>
                    </span>
                </li>
            </ul>
        </div>
    }
}

@section TopbarActions {
    @if (Model.Account is not null)
    {
        <a href="/">@await Html.PartialAsync("_Icon", "arrow-left") 返回插件市场</a>
        <a href="/connect/endsession" class="danger-link">@await Html.PartialAsync("_Icon", "log-out") 退出登录</a>
    }
}

@if (Model.Account is null)
{
    <h1>登录后继续</h1>
    <p class="lede">这台设备上还没有会话。选一个入口开始。</p>
    <p>
        <a asp-page="/Account/Login">登录</a>
        @if (Model.AllowRegistration)
        {
            <text> · <a asp-page="/Account/Register">注册一个账号</a></text>
        }
    </p>
}
else
{
    <div class="account">
        <div class="profile">
            <div class="avatar">@initials</div>
            <div>
                <h1>@displayName</h1>
                <div class="profile-sub">
                    <code>@Model.Account.UserName</code>
                    <span class="chip chip-ok">@await Html.PartialAsync("_Icon", "check") 已登录</span>
                    <span>回到插件市场即可继续刚才的操作</span>
                </div>
            </div>
        </div>

        <section class="section">
            <h2 class="section-title">账号信息</h2>
            <ul class="kv">
                <li><span class="k">用户名</span><span class="v"><code>@Model.Account.UserName</code></span></li>
                <li>
                    <span class="k">邮箱</span>
                    <span class="v">
                        @if (string.IsNullOrEmpty(Model.Account.Email))
                        {
                            <span class="chip chip-warn">未填写 · 口令丢了只能找管理员重置</span>
                        }
                        else
                        {
                            @Model.Account.Email
                        }
                    </span>
                </li>
            </ul>
        </section>

        <section class="section">
            <div class="sub-box">
                <div class="sub-head">
                    <span>@await Html.PartialAsync("_Icon", "fingerprint") 你的身份标识(sub)</span>
                    <button type="button" class="copy-btn" data-copy="@Model.Account.Id">
                        @await Html.PartialAsync("_Icon", "copy")<span>复制</span>
                    </button>
                </div>
                <div class="sub-value">@Model.Account.Id</div>
                <p class="sub-note">
                    把这串 sub 填进市场 API 的 <code>Auth__ModeratorSubjects__0</code>(compose 里的
                    <code>MODERATOR_SUBJECT</code>),这个账号就能进审核台 ——
                    审核员是市场自己的概念,不由认证服务决定。
                </p>
            </div>
        </section>

        <section class="section">
            <h2 class="section-title">修改口令</h2>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <p class="notice error">
                    @await Html.PartialAsync("_Icon", "alert")
                    <span>@Model.Error</span>
                </p>
            }
            @if (Model.PasswordChanged)
            {
                <p class="notice ok">
                    @await Html.PartialAsync("_Icon", "check")
                    <span>
                        口令已更新。其它设备会在下一次操作时被登出,它们手上的刷新令牌也已失效;
                        但<strong>已经签发的访问令牌切不掉</strong>,最长还能再用 @Model.AccessTokenLifetime.TotalMinutes 分钟。
                    </span>
                </p>
            }

            <form method="post">
                <label>
                    <span>当前口令</span>
                    <span class="control">
                        @await Html.PartialAsync("_Icon", "lock")
                        <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required placeholder="••••••••" />
                        <button type="button" class="reveal" data-reveal="@Html.IdFor(m => m.CurrentPassword)" aria-label="显示口令">
                            @await Html.PartialAsync("_Icon", "eye")
                        </button>
                    </span>
                </label>

                <label>
                    <span>新口令</span>
                    <span class="control">
                        @await Html.PartialAsync("_Icon", "key")
                        <input asp-for="NewPassword" type="password" autocomplete="new-password" required placeholder="••••••••" />
                        <button type="button" class="reveal" data-reveal="@Html.IdFor(m => m.NewPassword)" aria-label="显示口令">
                            @await Html.PartialAsync("_Icon", "eye")
                        </button>
                    </span>
                </label>

                @* 强度条只判断长度与字符类别这几条能自己判断的;真正的口令策略在服务端。 *@
                <div class="strength" data-score="0" data-strength-for="@Html.IdFor(m => m.NewPassword)"></div>

                <p class="notice warn">
                    @await Html.PartialAsync("_Icon", "alert")
                    <span>
                        改掉口令后,其它设备会在下一次操作时被登出,它们手上的刷新令牌立刻失效;
                        但已经签发的访问令牌切不掉,最长还能再用 @Model.AccessTokenLifetime.TotalMinutes 分钟。
                    </span>
                </p>

                <div class="actions-right">
                    <span class="hint">改完不会退出当前这台设备。</span>
                    <button type="submit">修改口令</button>
                </div>
            </form>
        </section>
    </div>
}
