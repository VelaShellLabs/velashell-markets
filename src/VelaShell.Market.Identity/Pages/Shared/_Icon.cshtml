@model string
@*
    一小撮内联图标。不引图标字体也不引 svg sprite:
    认证页只用到七八个图形,为它们多一个网络请求(还是个会失败的网络请求)不划算。
    线条参数与市场前端用的 lucide 一致,两边看起来是同一套。
*@
@*
    尺寸与颜色一律由 CSS 决定(currentColor + 外层给的 width/height),
    partial 只负责画形状 —— 这样调用处永远只写 `<partial name="_Icon" model="user" />`。
*@
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Model)
    {
        case "user":
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21a8 8 0 0 1 16 0" />
            break;
        case "lock":
            <rect x="4" y="10" width="16" height="11" rx="2" />
            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
            break;
        case "key":
            <circle cx="8" cy="14" r="4" />
            <path d="M11 11 21 1M18 4l2 2M15 7l2 2" />
            break;
        case "mail":
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
            break;
        case "smile":
            <circle cx="12" cy="12" r="9" />
            <path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01" />
            break;
        case "eye":
            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" />
            <circle cx="12" cy="12" r="3" />
            break;
        case "shield":
            <path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5Z" />
            break;
        case "shield-check":
            <path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5Z" />
            <path d="m9 12 2 2 4-4" />
            break;
        case "cookie":
            <circle cx="12" cy="12" r="9" />
            <path d="M9 9h.01M15 10h.01M10 15h.01M15 15h.01" />
            break;
        case "rotate":
            <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
            <path d="M3 3v5h5" />
            break;
        case "fingerprint":
            <path d="M12 11a2 2 0 0 1 2 2v1a6 6 0 0 1-.6 2.6" />
            <path d="M8 14v-1a4 4 0 0 1 8 0v1a10 10 0 0 1-1 4.5" />
            <path d="M5 13v-1a7 7 0 0 1 12-4.9" />
            <path d="M10 21a14 14 0 0 0 1.8-6" />
            break;
        case "copy":
            <rect x="9" y="9" width="12" height="12" rx="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            break;
        case "arrow-left":
            <path d="M19 12H5M11 18l-6-6 6-6" />
            break;
        case "log-out":
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <path d="m16 17 5-5-5-5M21 12H9" />
            break;
        case "alert":
            <path d="M12 3 2 20h20Z" />
            <path d="M12 10v4M12 17h.01" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5M12 8h.01" />
            break;
        case "check":
            <path d="m5 12 5 5L20 7" />
            break;
        case "at":
            <circle cx="12" cy="12" r="4" />
            <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8" />
            break;
    }
</svg>
