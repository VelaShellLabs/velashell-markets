@{
    string title = ViewData["Title"] as string ?? "统一认证";
    // 两种外壳:登录/注册用左右分栏(左边讲清楚"这是谁、令牌怎么走"),
    // 已登录的账户页用普通页面(那一页只是看信息 + 改口令,没有需要被说服的东西)。
    string shell = ViewData["Shell"] as string ?? "split";
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <title>@title · VelaShell</title>
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
</head>
<body>
@if (shell == "page")
{
    // 当前外壳用不到的 section 必须显式忽略:Razor 对"声明了却没人渲染"是直接抛异常的。
    if (IsSectionDefined("Aside"))
    {
        IgnoreSection("Aside");
    }
    <div class="page">
        <header class="topbar">
            <a href="/" class="brand">
                <partial name="_BrandMark" />
                <span class="brand-name">VelaShell</span>
                <span class="brand-rule"></span>
                <span class="brand-sub">统一认证</span>
            </a>
            <nav class="topbar-actions">
                @RenderSection("TopbarActions", required: false)
            </nav>
        </header>
        <main class="page-body">
            @RenderBody()
        </main>
    </div>
}
else
{
    if (IsSectionDefined("TopbarActions"))
    {
        IgnoreSection("TopbarActions");
    }
    <div class="split">
        <aside class="aside">
            <a href="/" class="brand">
                <partial name="_BrandMark" />
                <span class="brand-name">VelaShell</span>
                <span class="brand-rule"></span>
                <span class="brand-sub">统一认证</span>
            </a>

            @RenderSection("Aside", required: false)

            <div class="aside-foot">
                <span>OpenIddict · OIDC · 授权码 + PKCE</span>
                <span>@Context.Request.Host.Value</span>
            </div>
        </aside>
        <main class="main">
            <div class="form-wrap">
                @RenderBody()
            </div>
        </main>
    </div>
}
<script src="~/auth.js" asp-append-version="true" defer></script>
</body>
</html>
