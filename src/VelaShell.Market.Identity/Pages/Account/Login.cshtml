@page "/account/login"
@model LoginModel
@{
    ViewData["Title"] = "登录";
}

<h1>登录</h1>
<p class="lede">登录后回到你刚才的操作。</p>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <p class="notice error">@Model.Error</p>
}

<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <label>
        <span>用户名或邮箱</span>
        <input asp-for="Input.Login" autocomplete="username" autofocus required />
        <span asp-validation-for="Input.Login" class="field-error"></span>
    </label>
    <label>
        <span>口令</span>
        <input asp-for="Input.Password" type="password" autocomplete="current-password" required />
        <span asp-validation-for="Input.Password" class="field-error"></span>
    </label>
    <label class="check">
        <input asp-for="Input.RememberMe" type="checkbox" />
        <span>记住我</span>
    </label>
    <button type="submit">登录</button>
</form>

@if (Model.AllowRegistration)
{
    <p class="alt">还没有账号?<a asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">注册一个</a></p>
}
