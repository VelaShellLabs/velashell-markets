<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>VelaShell.Market.Infrastructure</RootNamespace>
    <Description>VelaShell 插件市场的基础设施:MongoDB 上下文与索引、S3/MinIO 对象存储、ClamAV 客户端,以及 .vpx 上传的隔离检测流水线。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VelaShell.Market.Domain\VelaShell.Market.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EasilyNET.Mongo.Core" />
    <PackageReference Include="VelaShell.PluginSdk" />
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Options / Logging.Abstractions / Hosting.Abstractions 直接取自共享框架,不逐个引包:
         预览版 .NET 上这些包的版本号每个 preview 都在动,钉错一个就是一串降级警告,
         而它们本来就随运行时一起交付。 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
