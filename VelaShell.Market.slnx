<Solution>
  <Folder Name="/build/">
    <File Path=".env" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="LICENSE.txt" />
    <File Path="nuget.config" />
    <File Path="README.md" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/VelaShell.Market.Api/VelaShell.Market.Api.csproj" />
    <Project Path="src/VelaShell.Market.Domain/VelaShell.Market.Domain.csproj" />
    <Project Path="src/VelaShell.Market.Identity/VelaShell.Market.Identity.csproj" />
    <Project Path="src/VelaShell.Market.Infrastructure/VelaShell.Market.Infrastructure.csproj" />
    <Project Path="src/VelaShell.Market.Web/VelaShell.Market.Web.esproj">
      <Build />
      <Deploy />
    </Project>
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/VelaShell.Market.Tests/VelaShell.Market.Tests.csproj" />
  </Folder>
  <Project Path="docker-compose.dcproj">
    <Build />
    <!-- 前端产物 dist/ 由 Web 项目在本机打包,compose 只是把它装进 nginx 镜像。
         这条依赖保证打镜像时 dist/ 已经是新的。 -->
    <BuildDependency Project="src/VelaShell.Market.Web/VelaShell.Market.Web.esproj" />
  </Project>
</Solution>
