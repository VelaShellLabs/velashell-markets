# docker compose 的可选覆盖项。复制成 .env 后按需修改。

# --- MongoDB ---------------------------------------------------------------
# 这两个值只在数据目录**为空**时用来创建 root 账号。已经跑过的部署要另行补建,
# 见 docs/deployment.md「给已有的 MongoDB 补上账号密码」。
# 口令里有 : @ / ? # 这类字符时,连接串里要写成百分号转义(如 @ -> %40)。
MONGO_ROOT_USER=market
MONGO_ROOT_PASSWORD=change-me-please

# --- 对象存储 --------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- 统一认证 --------------------------------------------------------------
# 认证服务对外的地址。它同时是令牌里的 iss、discovery 里所有端点的前缀,
# 以及前端发起登录时跳转过去的地址 —— 三处必须是同一个值。
# **浏览器打得开**才行:换成对外域名时连同反向代理一起配好。
IDENTITY_ISSUER=http://localhost:7020
# 生产必须为 true。关掉它等于允许令牌在明文里裸奔。
IDENTITY_REQUIRE_HTTPS=false
# 是否开放自助注册。关掉后只能由 BOOTSTRAP_* 或运维直接建账号。
ALLOW_SELF_REGISTRATION=true
# 首个账号:只在账号集合为空时创建。留空则去 http://localhost:7020/account/register 注册。
BOOTSTRAP_USER=
BOOTSTRAP_PASSWORD=

# 市场 API 侧
AUTH_AUDIENCE=velashell-market
# 生产必须为 true。关掉它等于允许中间人替换 discovery 与 JWKS。
AUTH_REQUIRE_HTTPS=false

# 前端来源(CORS,同时也是登录后的回跳白名单)
WEB_ORIGIN=http://localhost:8000

# 审核员的 sub —— 登录认证服务后首页会直接显示这串值。
# 留空则审核台无人可进,待复核的包会一直停在隔离区。
MODERATOR_SUBJECT=

ASPNETCORE_ENVIRONMENT=Production
