# docker compose 的可选覆盖项。复制成 .env 后按需修改。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# 身份认证。用 --profile identity 起同级仓库的 IdentityServer 时填 http://identity:8080。
AUTH_AUTHORITY=https://host.docker.internal:7020
AUTH_AUDIENCE=velashell-market
AUTH_REQUIRE_HTTPS=false

# 前端来源(CORS)
WEB_ORIGIN=http://localhost:8000

# 审核员的 sub(留空则审核台无人可进,待复核的包会一直停在隔离区)
MODERATOR_SUBJECT=

ASPNETCORE_ENVIRONMENT=Production
