                        },
                        {
                          "type": "text",
                          "id": "ZaZcz",
                          "name": "代码2",
                          "fill": "#E6E6F0",
                          "content": "vela-plugin install git-panel@2.0.0",
                          "lineHeight": 1.4,
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 12.5
                        },
                        {
