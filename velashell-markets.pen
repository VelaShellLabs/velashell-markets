                      "fontSize": 17,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "x7My6M",
                      "name": "文档段落 p1",
                      "fill": "$ink2",
                      "textGrowth": "fixed-width",
                      "width": 924,
                      "content": "git-panel 把最常用的 Git 操作搬进 VelaShell 的侧栏:暂存区逐块挑选、分支与 worktree 切换、冲突三向对比,以及一条命令都不用敲的交互式 rebase。多仓库可以同时挂载,状态各自独立。",
                      "lineHeight": 1.85,
                      "fontFamily": "Inter",
                      "fontSize": 13.5
                    },
                    {
                      "type": "frame",
                      "id": "LW5zU",
                      "name": "文档条目 l1",
                      "fill": "#00000000",
